ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/PPU_SDK/CUDA_SDK/bin/nvcc

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O3 -Wall -fPIC -I/mnt/workspace/PPU/gemv_optimization/sglang_kernel_v10/csrc -I/usr/local/lib/python3.12/site-packages/torch/include -I/usr/local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/usr/local/PPU_SDK/CUDA_SDK/include -I/usr/local/PPU_SDK/CUDA_SDK/include -I/usr/local/include/python3.12 -c
post_cflags = -O3 -fPIC -Wno-deprecated-declarations -Wno-abi -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C -std=c++17
cuda_cflags = -I/mnt/workspace/PPU/gemv_optimization/sglang_kernel_v10/csrc -I/usr/local/lib/python3.12/site-packages/torch/include -I/usr/local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/usr/local/PPU_SDK/CUDA_SDK/include -I/usr/local/PPU_SDK/CUDA_SDK/include -I/usr/local/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 --expt-relaxed-constexpr --expt-extended-lambda -gencode=arch=compute_80a,code=sm_80a --diag-suppress=39,174,177,940 --compiler-options=-fPIC,-O3,-Wno-deprecated-declarations,-Wno-abi -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







